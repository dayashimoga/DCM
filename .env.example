# ==========================================
# Distributed Compute Marketplace — Environment Config
# ==========================================

# Server Environment
NODE_ENV=development
PORT=4000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public

# In-Memory Cache / Queue (Redis 7)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=dev-super-secure-jwt-secret-key-32-chars-minimum
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=dev-super-secure-jwt-refresh-secret-key-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Platform Economics
PLATFORM_COMMISSION_RATE=0.15

# Web Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Distributed Compute Marketplace"

# Logging
LOG_LEVEL=info
