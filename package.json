{
  "name": "distributed-compute-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "A distributed GPU/CPU compute marketplace and intelligent orchestration platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "podman compose up",
    "dev:down": "podman compose down",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "validate": "powershell -ExecutionPolicy Bypass -File ./scripts/podman-validate.ps1",
    "validate:production": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-production.ps1",
    "certify": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-production.ps1",
    "production-certify": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-production.ps1"
  },
  "keywords": [
    "gpu",
    "compute",
    "marketplace",
    "distributed-systems",
    "orchestration",
    "ai",
    "hpc"
  ],
  "author": "Distributed Compute Network",
  "license": "Apache-2.0",
  "dependencies": {
    "@nestjs/throttler": "^6.5.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/helmet": "^0.0.48"
  }
}
